# Base URL the frontend uses to reach the backend API.
# Vite loads .env.development for `npm run dev` and .env.production for `npm run build`.
# If unset, the code falls back to http://localhost:8001/api (see src/api/client.js).

# Local dev (Vite dev server -> local backend):
VITE_API_URL=http://localhost:8001/api

# Production build (served behind nginx, which proxies /api to the backend):
# VITE_API_URL=/api
