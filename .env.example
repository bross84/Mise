# Copy this file to .env and fill in the values.
# docker-compose.yml and docker-compose.prod.yml load it into the backend container;
# for a manual backend run it is read from the project root on startup.

# Required for AI features (recipe/ingredient parsing, tag suggestions, the
# recipe edit assistant). Any OpenAI-compatible provider works.
#
# AI_API_KEY   — API key. OPENROUTER_API_KEY is still read as a fallback.
# AI_MODEL     — model id (default: deepseek/deepseek-chat)
# AI_BASE_URL  — API base URL (default: https://openrouter.ai/api/v1)
#
# Examples:
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1  AI_MODEL=deepseek/deepseek-chat
#   OpenAI:     AI_BASE_URL=https://api.openai.com/v1     AI_MODEL=gpt-4o-mini
#   Ollama:     AI_BASE_URL=http://localhost:11434/v1     AI_MODEL=llama3.1
#
# Get an OpenRouter key at https://openrouter.ai/keys
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
OPENROUTER_API_KEY=

# USDA FoodData Central key for ingredient search.
# Optional: without it, USDA lookups fall back to the shared "DEMO_KEY",
# which is rate-limited to ~30 requests/hour and 50/day per IP.
# Get a free key at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Open Food Facts needs no key.
